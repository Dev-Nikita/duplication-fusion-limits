# Whitelist: everything at the top level is ignored unless allowed below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/DATA_LICENSES.md
!/.zenodo.json
!/REPRODUCE.md
!/REPRODUCE_FINITE_CAP.md
!/MANIFEST.csv
!/Makefile
!/pyproject.toml
!/requirements_finite_cap.txt
!/requirements_lock_2026-11-16.txt
!/src/
!/tests/
!/tools/
!/experiments/
!/testbed/
!/results/
!/docs/

# Raw data and large outputs (not redistributed: size and licences of external data)
/data/
/data_external/
/testbed/out/
/testbed/*.tgz
/results/r1_audit.log
/results/**/*.pkl
/results/figures/
/experiments/redelivery/pilot_in/
/experiments/redelivery/pilot_out/
/experiments/redelivery/pilot_res/
/experiments/redelivery/bundle/
/experiments/redelivery/tools/
/experiments/redelivery/local_sha.txt
/experiments/multitype/bin/
/experiments/multitype/runs/

# Never anywhere
**/__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.venv/
*.egg-info/
*.bak
*.tex
*.bib
*.pdf
*.docx
*.zip
*.tgz
*.tar.gz
